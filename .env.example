PORT=3000

# Supabase (file sorter queue + case index)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Client / case-tracker Supabase (optional — medical billing lines on Approve)
# Run case_medical_records migration in that project first; service role bypasses RLS.
# CLIENT_SUPABASE_URL=https://your-client-project.supabase.co
# CLIENT_SUPABASE_SERVICE_ROLE_KEY=your-client-service-role-key
# MEDICAL_RECORDS_CAPTURE_ENABLED=true

# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
# Optional: model for scanned PDFs / photos (defaults to OPENAI_MODEL; use gpt-4o-mini or gpt-4o)
OPENAI_VISION_MODEL=
# Re-read attachment when email-only AI confidence is below this (default 0.5)
DOCUMENT_ANALYSIS_CONFIDENCE_THRESHOLD=0.5

# Slack
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
# Workspace subdomain for dashboard "Open in Slack" links (e.g. ramosjames)
SLACK_TEAM_DOMAIN=ramosjames
SLACK_FILE_SORTER_QUEUE_CHANNEL_ID=C0000000000
# @mention on new queue cards — rotates one user per post through the queue channel topic list.
# Set topic to @user1 @user2 … in Slack (use @ autocomplete so IDs are stored).
# Fallback when topic is empty: comma-separated IDs or emails below.
# SLACK_QUEUE_MENTION_USER_IDS=U0123ABC,laura@ramosjames.com
# SLACK_QUEUE_MENTION_ROTATE=true
# Weekday-only thread reminder after N hours unsorted (0 = off)
SLACK_QUEUE_REMINDER_HOURS=24
SLACK_QUEUE_REMINDER_CHECK_INTERVAL_MINUTES=60
SLACK_REMINDER_TIMEZONE=America/Chicago
# Public URL for dashboard links in Slack (no trailing slash)
PUBLIC_APP_URL=https://email-attachment-sorter-production.up.railway.app
# Weekday end-of-day status in queue channel (prior 24 hours)
SLACK_EOD_REPORT_ENABLED=true
SLACK_EOD_REPORT_TIME=17:00
SLACK_EOD_REPORT_HOURS=24
SLACK_EOD_REPORT_CHECK_INTERVAL_MINUTES=5

# Dropbox — use refresh token on Railway (required for 24/7 operation)
DROPBOX_APP_KEY=your-dropbox-app-key
DROPBOX_APP_SECRET=your-dropbox-app-secret
DROPBOX_REFRESH_TOKEN=your-dropbox-refresh-token
# Do NOT set DROPBOX_ACCESS_TOKEN when using refresh (sl. tokens expire in ~4h)
DROPBOX_CASES_ROOT=/RAMOS JAMES LAW CASES
DROPBOX_NAMESPACE_ID=13922258995
DROPBOX_SYNC_INTERVAL_MINUTES=60

# Google Sheet → case_slack_channels (share sheet with service account email as Viewer)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=Cases!A:F
# Paste full service account JSON on one line (recommended for Railway)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Or separate email + key (use \n for newlines in the private key)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# 0 = manual POST /admin/sync-cases-from-sheet only
CASE_SHEET_SYNC_INTERVAL_MINUTES=0

# Slack → case_slack_channels (no Google Sheet required; bot must be in case channels)
# channels:read scope; real-time via /webhooks/slack/events + 4h backfill
# channels:read + channels:join; auto-join public channels on each case sync
SLACK_CASE_SYNC_INTERVAL_MINUTES=240
# Default on — omit or set false/0 to disable
# SLACK_AUTO_JOIN_PUBLIC_CHANNELS=false
# SLACK_AUTO_JOIN_CASE_CHANNELS_ONLY=false
SLACK_JOIN_DELAY_MS=1500
SLACK_CASE_CHANNEL_EXCLUDE_NAMES=

# Optional: webhook secret for inbound email providers
INBOUND_EMAIL_WEBHOOK_SECRET=

# Temp attachment staging (Supabase Storage bucket file-sorter-temp)
TEMP_STORAGE_ROUTED_DELETE_AFTER_MINUTES=1
# 336 h = 14 days for queue items not yet filed to Dropbox
TEMP_STORAGE_UNROUTED_TTL_HOURS=336
TEMP_STORAGE_CLEANUP_INTERVAL_MINUTES=15
